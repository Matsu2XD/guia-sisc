<section id="acesso-sistema" class="space-y-4">
  <SectionHeader number="4.1" title="Acesso ao sistema" accent="blue" subtitle="Login e tela inicial do SISC" />
  <SecaoTutorialCarousel
    id="acesso-sisc"
    titulo="Acesso ao SISC"
    descricao="Fluxo de acesso ao SISC por meio do Sistema de Autenticação e Autorização (SAA) e da tela inicial do sistema."
    paginas={acessoCarousel}
    observacao="O acesso ao sistema requer cadastro no SAA (Sistema de Autenticação e Autorização) com perfil de acesso ao SISC, concedido pelo Administrador Titular ou Adjunto do Órgão Gestor."
  />
</section>

<section id="menu-grupos" class="space-y-4">
  <SectionHeader number="4.2" title="Menu Grupos" accent="green" subtitle="Incluir, consultar, alterar, vincular e desativar grupos" />
  <SecaoTutorialCarousel
    id="grupos-sisc"
    titulo="Gestão de Grupos do SCFV"
    descricao="Do cadastro de grupos à desativação e histórico, todas as funcionalidades do menu Grupos do SISC."
    paginas={gruposCarousel}
  />
</section>

<section id="menu-usuarios" class="space-y-4">
  <SectionHeader number="4.3" title="Menu Usuários" accent="purple" subtitle="Consulta, cadastro provisório, vínculo, desvinculação e confirmação de participação" />
  <SecaoTutorialCarousel
    id="usuarios-sisc"
    titulo="Gestão de Usuários do SCFV"
    descricao="Todas as funcionalidades relacionadas aos usuários do Serviço de Convivência e Fortalecimento de Vínculos no SISC."
    paginas={usuariosCarousel}
    observacao="A confirmação de participação deve ser realizada até o dia 20 do último mês do trimestre, conforme a Portaria MDS nº 134/2013."
  />
</section>

<section id="menu-relatorios" class="space-y-4">
  <SectionHeader number="4.4" title="Menu Relatórios" accent="cyan" subtitle="Relatório Principal, Situações Prioritárias e Confirmação de Participação" />
  <SecaoTutorialCarousel
    id="relatorios-sisc"
    titulo="Relatórios do SISC"
    descricao="Relatórios pré-definidos para o acompanhamento e a gestão do SCFV: Principal, Situações Prioritárias e Confirmação de Participação."
    paginas={relatoriosCarousel}
  />

  <div class="mt-4">
    <AlertBox variant="info" title="Nota sobre as capturas de tela">
      As capturas de tela apresentadas correspondem ao Manual do SISC (SNAS/MDS). O layout do sistema passou por atualizações (padrão gov.br) em 2025; a organização dos menus e das funcionalidades permanece a mesma.
    </AlertBox>
  </div>
</section>
